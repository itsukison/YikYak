# HearSay App - Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git - it contains sensitive credentials

# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Anthropic API (for AI features)
ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
ANTHROPIC_AUTH_TOKEN=your-anthropic-token-here

# Instructions:
# 1. Get your Supabase URL and anon key from: https://app.supabase.com/project/_/settings/api
# 2. Get your Anthropic API token from: https://api.z.ai
# 3. Copy this file to .env and replace the placeholder values
# 4. Verify .env is listed in .gitignore to prevent accidental commits
